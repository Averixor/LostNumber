# Local AAB/APK inspection artifacts (bundletool dumps)
current_manifest.xml
old_manifest.xml
bundletool.jar
*.apks
dummy.c
libdummy.so

# Signing (never commit)
android/keystore/
android/keystore.properties
*.jks
*.keystore

# Firebase google-services (real secrets — never commit)
android/firebase/**/google-services.json
!android/firebase/google-services.example.json

# Backup / transient artifacts
*.bak
*.broken
*.swp
*.swo

# Node / tooling artifacts
node_modules/
privacy-host/

# Godot cache
godot/.godot/

# Android / Gradle (do not ignore all `android/`)
android/.gradle/
android/app/
android/build/
android/local.properties
.gradle/
**/.gradle/
**/build/
**/intermediates/
**/outputs/

# Build artifacts (root) — keep only `build/android/README.md` trackable
/build/
!/build/android/
/build/android/*
!/build/android/README.md
/_site/

# IDE metadata (Android Studio / IntelliJ)
.vscode/
.idea/
android/.idea/

# Local browser/debug profiles
.chrome-*/

# Local review artifacts (saved diffs, not part of the game)
_review-diff*.patch

# Local project/cache databases
.project/
.project/*.sqlite
.project/*.sqlite-wal
.project/*.sqlite-shm
.project/.temp/**
.project/complete_drafts.txt
.project/localProjectSettings.json
.project/localProjectSwap.json
.project/attachments/files/**
copilot-messages.log

