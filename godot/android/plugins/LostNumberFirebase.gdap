[config]

name="LostNumberFirebase"
binary_type="local"
binary="LostNumberFirebasePlugin/LostNumberFirebasePlugin-release.aar"

[dependencies]

remote=["platform(com.google.firebase:firebase-bom:34.17.0)", "com.google.firebase:firebase-auth", "androidx.credentials:credentials:1.3.0", "androidx.credentials:credentials-play-services-auth:1.3.0", "com.google.android.libraries.identity.googleid:googleid:1.1.1"]

[android]

min_sdk="24"
target_sdk="36"
